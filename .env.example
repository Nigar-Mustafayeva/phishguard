# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file. It is excluded in .gitignore.

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# development  OR  production
FLASK_CONFIG=development

# Local dev uses SQLite. On Render you will set a PostgreSQL URL here.
DATABASE_URL=sqlite:///platform.db

# When true, GoPhish integration returns clearly-labelled synthetic data
# instead of sending real email. Keep this TRUE for the public demo.
DEMO_MODE=true

# Seed synthetic demo data on first deploy (used by `flask init-app`).
SEED_DEMO=true

# First admin account, created on first deploy by `flask init-app`.
# Set these in the Render dashboard, NOT in a committed file.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ---- GoPhish (Stage 7, optional, lab only) ----
GOPHISH_API_URL=https://localhost:3333
GOPHISH_API_KEY=

# ---- Mailtrap SMTP sandbox (Stage 5, safe testing) ----
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
